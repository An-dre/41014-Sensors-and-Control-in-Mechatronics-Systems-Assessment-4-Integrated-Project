<mujoco model="calibration">
  <!-- B4 calibration scene. Same robot and camera as sceneforturtle.xml, plus an
       8 x 6 chessboard of 0.1 m squares (7 x 5 inner corners), centre (2.0, 0, 0.35),
       facing -x. Used only by "python sensing.py calib"; the group's scene is untouched. -->
  <include file="turtlebot3_waffle_pi.xml"/>
  <!-- rangefinder alpha 0: hide the lidar rays, otherwise they are drawn across the board
       in the camera image and the corner finder fails -->
  <visual>
    <headlight ambient="0.7 0.7 0.7" diffuse="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba rangefinder="0 0 0 0"/>
  </visual>
  <worldbody>
    <geom name="calib_floor" type="plane" size="5 5 0.1" rgba="0.6 0.6 0.6 1"/>
    <!-- white border behind the board so the corner finder sees clean outer edges -->
    <geom name="calib_backing" type="box" pos="2.003 0 0.35" size="0.002 0.55 0.42"
          rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom type="box" pos="2.0 -0.350 0.100" size="0.001 0.05 0.05" rgba="0 0 0 1" contype="0" conaffinity="0"/>
    <geom type="box" pos="2.0 -0.250 0.100" size="0.001 0.05 0.05" rgba="1 1 1 1" contype="0" conaffinity="0"/>
